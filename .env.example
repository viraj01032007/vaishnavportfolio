# Set these in Vercel → Project → Settings → Environment Variables (not needed for plain `npm run dev`).

# Added automatically when you connect a Blob store (Vercel → Storage → Create → Blob, access: Public).
# Older stores use BLOB_READ_WRITE_TOKEN instead; either works.
BLOB_STORE_ID=

# Optional: starting admin password / PIN until you change them in the admin panel.
# Defaults are Vaishnav@2026 and 1234.
ADMIN_PASSWORD=
ADMIN_PIN=

# Optional: secret for signing admin sessions. Defaults to a random secret kept in the Blob store.
SESSION_SECRET=
