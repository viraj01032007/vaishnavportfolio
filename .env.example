# Set these in Vercel → Project → Settings → Environment Variables (not needed for plain `npm run dev`).

# Added automatically when you connect a Blob store to the project (Vercel → Storage → Create → Blob).
BLOB_READ_WRITE_TOKEN=

# Optional: starting admin password / PIN until you change them in the admin panel.
# Defaults are Vaishnav@2026 and 1234.
ADMIN_PASSWORD=
ADMIN_PIN=

# Optional: secret for signing admin sessions. Defaults to a value derived from BLOB_READ_WRITE_TOKEN.
SESSION_SECRET=
