rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Admin email (must match the Firebase Auth user).
    function isAdmin() { return request.auth != null && request.auth.token.email == "rajputviraj0103@gmail.com"; }

    match /uploads/{file} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|video/.*');
    }
  }
}
